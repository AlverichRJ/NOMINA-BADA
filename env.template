# ============================================================
# env.template — Variables de entorno para servidor propio
# Copia este archivo a .env y configura los valores reales:
#   cp env.template .env && nano .env
# ============================================================

# Base de datos MySQL
DATABASE_URL=mysql://asistencias:TU_PASSWORD@localhost:3306/asistencias

# Secreto para firmar JWT (generar con: openssl rand -base64 32)
JWT_SECRET=GENERAR_CON_openssl_rand_-base64_32

# Google OAuth 2.0
# Obtener en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-TU_CLIENT_SECRET

# Email del dueño del sistema (se auto-promueve a admin en el primer login)
OWNER_EMAIL=tu_email@gmail.com

# URL base del servidor (sin slash al final)
# En red local: http://192.168.10.73
# Con dominio: https://sistemabadabun.com
APP_BASE_URL=http://192.168.10.73

# Directorio para subir archivos (logos, etc.)
# Ruta absoluta recomendada en producción
UPLOADS_DIR=/var/www/asistencias/uploads

# Entorno
NODE_ENV=production
PORT=3000
